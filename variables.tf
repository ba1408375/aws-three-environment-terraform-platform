########################################################
# Missing-service platform
########################################################

variable "platform_allowed_cidrs" {
  description = "CIDR ranges allowed to reach the public platform service ports; narrow this for non-demo deployments"
  type        = list(string)
  default     = ["0.0.0.0/0"]

  validation {
    condition     = length(var.platform_allowed_cidrs) > 0 && alltrue([for cidr in var.platform_allowed_cidrs : can(cidrnetmask(cidr))])
    error_message = "platform_allowed_cidrs must contain at least one valid IPv4 CIDR."
  }
}

variable "platform_nifi_username" {
  description = "Single-user administrator name for the private NiFi UI"
  type        = string
  default     = "admin"

  validation {
    condition     = length(var.platform_nifi_username) >= 4
    error_message = "platform_nifi_username must contain at least four characters."
  }
}

variable "platform_images" {
  description = "Pinned public images used by the missing-service platform"
  type = object({
    static_web = string
    tensorflow = string
    kong       = string
    nifi       = string
    mediamtx   = string
  })

  default = {
    static_web = "nginx:1.28.0-alpine"
    tensorflow = "tensorflow/serving:2.20.0"
    kong       = "kong/kong-gateway:3.10.0.2"
    nifi       = "apache/nifi:2.10.0"
    mediamtx   = "bluenviron/mediamtx:1.18.2"
  }
}

variable "faas_public_access" {
  description = "Whether the demonstration Lambda Function URL is public; set false to require AWS IAM signed requests"
  type        = bool
  default     = true
}
