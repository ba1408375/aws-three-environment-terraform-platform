#######################################
# AWS Region
#######################################

variable "aws_region" {
  description = "AWS Region"
  type        = string
  default     = "us-east-1"
}

#######################################
# Dev, test, and production EC2 sizing
#######################################

variable "environment_instances" {
  description = "Exactly three EC2 environments and the capacity assigned to each full service stack"

  type = map(object({
    instance_type    = string
    root_volume_size = number
    subnet_cidr      = string
  }))

  default = {
    dev = {
      instance_type    = "m7i.2xlarge"
      root_volume_size = 150
      subnet_cidr      = "10.42.10.0/24"
    }
    test = {
      instance_type    = "m7i.2xlarge"
      root_volume_size = 150
      subnet_cidr      = "10.42.20.0/24"
    }
    production = {
      instance_type    = "m7i.4xlarge"
      root_volume_size = 300
      subnet_cidr      = "10.42.30.0/24"
    }
  }

  validation {
    condition     = toset(keys(var.environment_instances)) == toset(["dev", "test", "production"])
    error_message = "environment_instances must contain exactly dev, test, and production."
  }

  validation {
    condition = alltrue([
      for environment in values(var.environment_instances) :
      environment.root_volume_size >= 100
    ])
    error_message = "Each environment needs at least 100 GB for the combined container images and persistent volumes."
  }

  validation {
    condition = alltrue([
      for environment in values(var.environment_instances) :
      can(cidrnetmask(environment.subnet_cidr))
    ])
    error_message = "Each environment subnet_cidr must be a valid IPv4 CIDR."
  }
}

